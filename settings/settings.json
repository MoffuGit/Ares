{
  "appearance": "system",
  "light_theme": "light",
  "dark_theme": "zenbones",
  "tabs_position":"vertical",
  "keymaps": {
    "global": {
      "normal": {
        "i": "enterInsert",
        "v": "enterVisual",
        "super+b": "toggleLeftSidebar",
        "ctrl+t": "newTab",
        "tab": "nextTab",
        "shift+tab": "prevTab",
        "ctrl+q": "closeActiveTab",
        "super+k": "toggleCommandPalette",
        "super+p t": "tabsPanel",
        "super+p f": "filetreePanel",
        "super+t": "newTerminalTab"
      },
      "insert": {
        "escape": "enterNormal"
      },
      "visual": {
        "escape": "enterNormal"
      }
    },
    "command_palette": {
      "normal": {
        "escape": "close",
        "shift+tab": "up",
        "tab": "down",
        "enter": "select"
      }
    },
    "editor": {
        "normal": {
            "k": "cursor_up",
            "j": "cursor_down",
            "l": "cursor_right",
            "h": "cursor_left",
            "ctrl+d": "scroll_down",
            "ctrl+u": "scroll_up"
        }
    }
  }
}
