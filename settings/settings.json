{
  "appearance": "system",
  "light_theme": "light",
  "dark_theme": "zenbones",
  "tabs_position":"vertical",
  "keymaps": {
    "global": {
      "normal": {
        "i": "global:enterInsert",
        "v": "global:enterVisual",
        "super+b": "global:toggleLeftSidebar",
        "ctrl+t": "global:newTab",
        "tab": "global:nextTab",
        "shift+tab": "global:prevTab",
        "ctrl+q": "global:closeActiveTab",
        "super+k": "global:toggleCommandPalette",
        "super+p t": "global:tabsPanel",
        "super+p f": "global:filetreePanel",
        "super+t": "global:newTerminalTab",
        "shift+;": "global:toggleCmd"
      },
      "insert": {
        "escape": "global:enterNormal"
      },
      "visual": {
        "escape": "global:enterNormal"
      }
    },
    "command_palette": {
      "normal": {
        "k": "command:up",
        "j": "command:down",
        "enter": "command:select",
        "ctrl+u": "command:scroll_up",
        "ctrl+d": "command:scroll_down",
        "g g": "command:top",
        "shift+g": "command:bottom"
      }
    }
  }
}
