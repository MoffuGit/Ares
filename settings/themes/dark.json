{
  "name": "dark",
  "colors": {
    "background": "#0a0a0a",
    "foreground": "#eeeeeeff",
    "scrollThumb": "#666666",
    "scrollTrack": "#333333",
    "border-900": "#484848",
    "border-800": "#3c3c3c",
    "primaryBg": "#1a1a1a",
    "primaryFg": "#ffffff",
    "mutedBg": "#2a2a2a",
    "mutedFg": "#888888",
    "defaultFileColor": "#888888",
    "destructive": "#7f1d1d",
    "destructiveFg": "#ffffff",
    "selection": "#1c2833",
    "selectionFg": "#f5f8fa",
    "syntaxComment": "#6f7d89",
    "syntaxKeyword": "#ff7b72",
    "syntaxString": "#a5d6ff",
    "syntaxNumber": "#79c0ff",
    "syntaxType": "#ffa657",
    "syntaxFunction": "#d2a8ff",
    "syntaxVariable": "#e6edf3",
    "syntaxConstant": "#7ee787",
    "chart1": "#e76f51",
    "chart2": "#2a9d8f",
    "chart3": "#e9c46a",
    "chart4": "#a78bfa",
    "chart5": "#f4845f",
    "modeNormal": "#1a1a1a",
    "modeVisual": "#2a1a3a",
    "modeInsert": "#1a2a3a"
  },
  "theme": {
    "bg": "background",
    "fg": "foreground",
    "primaryBg": "primaryBg",
    "primaryFg": "primaryFg",
    "mutedBg": "mutedBg",
    "mutedFg": "mutedFg",
    "scrollThumb": "scrollThumb",
    "scrollTrack": "scrollTrack",
    "border": "border-900",
    "card": "background",
    "cardFg": "foreground",
    "popover": "background",
    "popoverFg": "foreground",
    "secondary": "mutedBg",
    "secondaryFg": "mutedFg",
    "accent": "mutedBg",
    "accentFg": "mutedFg",
    "destructive": "destructive",
    "destructiveFg": "destructiveFg",
    "input": "border-900",
    "ring": "primaryBg",
    "chart1": "chart1",
    "chart2": "chart2",
    "chart3": "chart3",
    "chart4": "chart4",
    "chart5": "chart5",
    "sidebar": "mutedBg",
    "sidebarFg": "foreground",
    "sidebarPrimary": "primaryBg",
    "sidebarPrimaryFg": "primaryFg",
    "sidebarAccent": "mutedBg",
    "sidebarAccentFg": "mutedFg",
    "sidebarBorder": "border-900",
    "sidebarRing": "primaryBg",
    "modeNormal": "modeNormal",
    "modeVisual": "modeVisual",
    "modeInsert": "modeInsert",
    "fileType": {
      "default": "defaultFileColor"
    }
  },
  "highlights": {
    "globals": {
      "background": "background",
      "foreground": "foreground",
      "caret": "foreground",
      "line_highlight": "primaryBg",
      "selection": "selection",
      "selection_foreground": "selectionFg",
      "gutter": "background",
      "gutter_foreground": "mutedFg"
    },
    "rules": [
      {
        "name": "Comments",
        "scope": "comment",
        "foreground": "syntaxComment",
        "font_style": "italic"
      },
      {
        "name": "Keywords",
        "scopes": ["keyword", "storage"],
        "foreground": "syntaxKeyword"
      },
      {
        "name": "Strings",
        "scope": "string",
        "foreground": "syntaxString"
      },
      {
        "name": "Numbers",
        "scope": "constant.numeric",
        "foreground": "syntaxNumber"
      },
      {
        "name": "Types",
        "scopes": ["entity.name.type", "support.type", "storage.type"],
        "foreground": "syntaxType"
      },
      {
        "name": "Functions",
        "scopes": ["entity.name.function", "support.function"],
        "foreground": "syntaxFunction"
      },
      {
        "name": "Constants",
        "scopes": ["constant.language", "support.constant"],
        "foreground": "syntaxConstant"
      },
      {
        "name": "Variables",
        "scopes": ["variable", "variable.parameter"],
        "foreground": "syntaxVariable"
      }
    ]
  }
}
