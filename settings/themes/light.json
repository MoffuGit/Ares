{
  "name": "light",
  "colors": {
    "background": "#E6E3E1",
    "foreground": "#141414",
    "scrollThumb": "#999999",
    "scrollTrack": "#cccccc",
    "border": "#BDB4AF",
    "primaryBg": "#FFFFFF",
    "primaryFg": "#000000",
    "mutedBg": "#F0EEED",
    "mutedFg": "#666666",
    "accentBg": "#C9C1BD",
    "accentFg": "#141414",
    "defaultFileColor": "#666666",
    "zig": "#c89a00",
    "destructive": "#dc2626",
    "destructiveFg": "#ffffff",
    "selection": "#c9c1bd",
    "selectionFg": "#141414",
    "syntaxComment": "#8a7d76",
    "syntaxKeyword": "#a13c28",
    "syntaxString": "#2f6f44",
    "syntaxNumber": "#0f67a6",
    "syntaxType": "#8c5e00",
    "syntaxFunction": "#6d3bb8",
    "syntaxVariable": "#141414",
    "syntaxConstant": "#8f2d56",
    "chart1": "#e76f51",
    "chart2": "#2a9d8f",
    "chart3": "#e9c46a",
    "chart4": "#7c3aed",
    "chart5": "#f4845f",
    "sidebar": "#E6E3E1",
    "sidebarFg": "#3F3F3F",
    "modeNormal": "#3e90dd",
    "modeVisual": "#d27236",
    "modeInsert": "#9e7ad9"
  },
  "theme": {
    "bg": "background",
    "fg": "foreground",
    "primaryBg": "primaryBg",
    "primaryFg": "primaryFg",
    "mutedBg": "mutedBg",
    "mutedFg": "mutedFg",
    "scrollThumb": "scrollThumb",
    "scrollTrack": "scrollTrack",
    "border": "border",
    "card": "primaryBg",
    "cardFg": "foreground",
    "popover": "primaryBg",
    "popoverFg": "foreground",
    "secondary": "mutedBg",
    "secondaryFg": "mutedFg",
    "accent": "accentBg",
    "accentFg": "accentFg",
    "destructive": "destructive",
    "destructiveFg": "destructiveFg",
    "input": "border",
    "ring": "primaryBg",
    "chart1": "chart1",
    "chart2": "chart2",
    "chart3": "chart3",
    "chart4": "chart4",
    "chart5": "chart5",
    "sidebar": "sidebar",
    "sidebarFg": "sidebarFg",
    "sidebarPrimary": "primaryBg",
    "sidebarPrimaryFg": "primaryFg",
    "sidebarAccent": "accentBg",
    "sidebarAccentFg": "accentFg",
    "sidebarBorder": "border",
    "sidebarRing": "primaryBg",
    "modeNormal": "modeNormal",
    "modeVisual": "modeVisual",
    "modeInsert": "modeInsert",
    "fileType": {
      "default": "defaultFileColor"
    }
  },
  "highlights": {
    "globals": {
      "background": "background",
      "foreground": "foreground",
      "caret": "foreground",
      "line_highlight": "mutedBg",
      "selection": "selection",
      "selection_foreground": "selectionFg",
      "gutter": "background",
      "gutter_foreground": "mutedFg"
    },
    "rules": [
      {
        "name": "Comments",
        "scope": "comment",
        "foreground": "syntaxComment",
        "font_style": "italic"
      },
      {
        "name": "Keywords",
        "scopes": ["keyword", "storage"],
        "foreground": "syntaxKeyword"
      },
      {
        "name": "Strings",
        "scope": "string",
        "foreground": "syntaxString"
      },
      {
        "name": "Numbers",
        "scope": "constant.numeric",
        "foreground": "syntaxNumber"
      },
      {
        "name": "Types",
        "scopes": ["entity.name.type", "support.type", "storage.type"],
        "foreground": "syntaxType"
      },
      {
        "name": "Functions",
        "scopes": ["entity.name.function", "support.function"],
        "foreground": "syntaxFunction"
      },
      {
        "name": "Constants",
        "scopes": ["constant.language", "support.constant"],
        "foreground": "syntaxConstant"
      },
      {
        "name": "Variables",
        "scopes": ["variable", "variable.parameter"],
        "foreground": "syntaxVariable"
      }
    ]
  }
}
