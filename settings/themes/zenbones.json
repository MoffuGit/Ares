{
  "name": "zenbones",
  "colors": {
    "background": "#030202",
    "foreground": "#f0eeee",
    "scrollThumb": "#a1a1a1",
    "scrollTrack": "#282828",
    "border": "#282828",
    "primaryBg": "#1447e6",
    "primaryFg": "#f0eeee",
    "popoverBg": "#030202",
    "mutedBg": "#110E0E",
    "mutedFg": "#989696",
    "gutter": "#675A52",
    "defaultFileColor": "#f0eeee",
    "destructive": "#ff6467",
    "destructiveFg": "#fafafa",
    "selection": "#1e1b1b",
    "selectionFg": "#fafafa",
    "syntaxComment": "#8b8685",
    "syntaxKeyword": "#ff7b72",
    "syntaxString": "#8ad58a",
    "syntaxNumber": "#91c5ff",
    "syntaxType": "#f7be95",
    "syntaxFunction": "#b58cf8",
    "syntaxVariable": "#f0eeee",
    "syntaxConstant": "#74c7b8",
    "chart1": "#91c5ff",
    "chart2": "#3a81f6",
    "chart3": "#2563ef",
    "chart4": "#1a4eda",
    "chart5": "#1f3fad",
    "sidebarBg": "#030202",
    "sidebarFg": "#D2CCCC",
    "secondaryFg": "#fafafa",
    "secondaryBg": "#262626",
    "accentBg": "#1E1B1B",
    "accentFg": "#fafafa",
    "cardBg": "#0C0B0E",
    "cardFg": "#fafafa",
    "input": "#343434",
    "ring": "#737373",
    "modeNormal": "#48a5fd",
    "modeVisual": "#00b3bc",
    "modeInsert": "#b58cf8"
  },
  "theme": {
    "bg": "background",
    "fg": "foreground",
    "primaryBg": "primaryBg",
    "primaryFg": "primaryFg",
    "mutedBg": "mutedBg",
    "mutedFg": "mutedFg",
    "gutter": "gutter",
    "scrollThumb": "scrollThumb",
    "scrollTrack": "scrollTrack",
    "border": "border",
    "card": "cardBg",
    "cardFg": "cardFg",
    "popover": "popoverBg",
    "popoverFg": "cardFg",
    "secondary": "secondaryBg",
    "secondaryFg": "secondaryFg",
    "accent": "accentBg",
    "accentFg": "accentFg",
    "destructive": "destructive",
    "destructiveFg": "destructiveFg",
    "input": "input",
    "ring": "ring",
    "chart1": "chart1",
    "chart2": "chart2",
    "chart3": "chart3",
    "chart4": "chart4",
    "chart5": "chart5",
    "sidebar": "sidebarBg",
    "sidebarFg": "sidebarFg",
    "sidebarPrimary": "primaryBg",
    "sidebarPrimaryFg": "primaryFg",
    "sidebarAccent": "accentBg",
    "sidebarAccentFg": "accentFg",
    "sidebarBorder": "border",
    "sidebarRing": "ring",
    "modeNormal": "modeNormal",
    "modeVisual": "modeVisual",
    "modeInsert": "modeInsert",
    "fileType": {
      "default": "accentFg"
    }
  },
  "highlights": {
    "globals": {
      "background": "background",
      "foreground": "foreground",
      "caret": "foreground",
      "line_highlight": "mutedBg",
      "selection": "selection",
      "selection_foreground": "selectionFg",
      "gutter": "gutter",
      "gutter_foreground": "mutedFg"
    },
    "rules": [
      {
        "name": "Comments",
        "scope": "comment",
        "foreground": "syntaxComment",
        "font_style": "italic"
      },
      {
        "name": "Keywords",
        "scopes": ["keyword", "storage"],
        "foreground": "syntaxKeyword"
      },
      {
        "name": "Strings",
        "scope": "string",
        "foreground": "syntaxString"
      },
      {
        "name": "Numbers",
        "scope": "constant.numeric",
        "foreground": "syntaxNumber"
      },
      {
        "name": "Types",
        "scopes": ["entity.name.type", "support.type", "storage.type"],
        "foreground": "syntaxType"
      },
      {
        "name": "Functions",
        "scopes": ["entity.name.function", "support.function"],
        "foreground": "syntaxFunction"
      },
      {
        "name": "Constants",
        "scopes": ["constant.language", "support.constant"],
        "foreground": "syntaxConstant"
      },
      {
        "name": "Variables",
        "scopes": ["variable", "variable.parameter"],
        "foreground": "syntaxVariable"
      }
    ]
  }
}
